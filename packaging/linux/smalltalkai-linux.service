[Unit]
Description=SmallTalkAI Linux capture daemon
After=graphical-session.target xdg-desktop-portal.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/smalltalkai daemon
ExecStop=/usr/bin/smalltalkai shutdown
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
